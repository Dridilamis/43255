    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="fr">niée</rdfs:label>
    <rdfs:comment xml:lang="fr">Vrai si l'entité est explicitement niée (absence conservée comme information).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b21">
