    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#BIOMARQUEUR"/>
    <rdfs:label xml:lang="fr">score sofa inclut biomarqueur</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#score_sofa_inclut_signe_vital">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SCORE_SOFA"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#SIGNE_VITAL"/>
    <rdfs:label xml:lang="fr">score sofa inclut signe vital</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#score_sofa_calcule_pour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SCORE_SOFA"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:label xml:lang="fr">score sofa calcule pour</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#issuDuDossier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#Dossier"/>
    <rdfs:label xml:lang="fr">issu du dossier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b15">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#CONTEXTE_ACQUISITION"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b16"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#SCORE_SOFA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">score sofa</rdfs:label>
    <rdfs:comment xml:lang="fr">Score SOFA total et ses 6 composantes (evaluation centrale de la dysfonction d'organe).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#hypothese">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="fr">hypothèse</rdfs:label>
    <rdfs:comment xml:lang="fr">Vrai si l'entité est seulement suspectée ou évoquée.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#signalFaible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">signal faible</rdfs:label>
    <rdfs:comment xml:lang="fr">Signal faible relevé par l'arbitrage.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#micro_organisme_infecte_site">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_BIOMARQUEURS_ET_MICROBIO"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#MICRO_ORGANISME"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#FOYER_INFECTIEUX"/>
    <rdfs:label xml:lang="fr">micro organisme infecte site</rdfs:label>
    <rdfs:comment xml:lang="fr">Le pathogene est responsable de l'infection de ce site (site d'infection), a distinguer de micro_organisme_isole_dans (site ou il a ete preleve ou isole). Creee uniquement si le document relie explicitement le pathogene au site infecte.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b4">
