    <skos:example>arret_antibiotherapie</skos:example>
    <skos:example>debut_remplissage_vasculaire</skos:example>
    <skos:example>debut_vasopresseurs</skos:example>
    <skos:example>sevrage_vasopresseurs</skos:example>
    <skos:example>mesure_lactate_T0</skos:example>
    <skos:example>mesure_lactate_T2h</skos:example>
    <skos:example>controle_source</skos:example>
    <skos:example>intubation_orotracheale</skos:example>
    <skos:example>extubation</skos:example>
    <skos:example>reintubation</skos:example>
    <skos:example>tracheotomie</skos:example>
    <skos:example>debut_epuration_extra_renale</skos:example>
    <skos:example>arret_epuration_extra_renale</skos:example>
    <skos:example>transfusion</skos:example>
    <skos:example>intervention_chirurgicale</skos:example>
    <skos:example>transfert_service</skos:example>
    <skos:example>sortie_reanimation</skos:example>
    <skos:example>sortie_hopital</skos:example>
    <skos:example>arret_cardiorespiratoire</skos:example>
    <skos:example>deces</skos:example>
    <rdfs:comment xml:lang="fr">Evenements horodates cles de la trajectoire clinique et therapeutique, incluant les jalons SSC et les evenements majeurs du sejour.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#score_qsofa_inclut_score_neurologique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SCORE_qSOFA"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#SCORE_NEUROLOGIQUE"/>
    <rdfs:label xml:lang="fr">score qsofa inclut score neurologique</rdfs:label>
    <rdfs:comment xml:lang="fr">Le qSOFA inclut le critere neurologique (confusion ou Glasgow &lt; 15, voir R4bis). Validee par le medecin.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#EVOLUTION_PRONOSTIC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">evolution pronostic</rdfs:label>
    <rdfs:comment xml:lang="fr">Evolution clinique, devenir du patient et mesures de sejour.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#COMORBIDITE_ANTECEDENT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">comorbidite antecedent</rdfs:label>
    <rdfs:comment xml:lang="fr">Antecedents medicaux, comorbidites chroniques et diagnostics d'EPISODES ANTERIEURS dont le nom n'est pas dans la liste valeurs_autorisees de LABEL_NOSOLOGIQUE (y compris les antecedents infectieux hors liste, ex. tuberculose ancienne), influencant le terrain de risque infectieux.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#evenement_associe_evolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_TEMPORELLES_ET_PRONOSTIC"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#EVENEMENT_TEMPOREL"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#EVOLUTION_PRONOSTIC"/>
    <rdfs:label xml:lang="fr">evenement associe evolution</rdfs:label>
    <rdfs:comment xml:lang="fr">Relation generique remplacant delai_ATB_superieur_60min_associe_mortalite. Le seuil (60 min) est porte par regles_derivees.R2, pas par le nom de la relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#a_pour_label_nosologique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#LABEL_NOSOLOGIQUE"/>
    <rdfs:label xml:lang="fr">a pour label nosologique</rdfs:label>
    <rdfs:comment xml:lang="fr">Lien entre le patient et son diagnostic (LABEL_NOSOLOGIQUE).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#service_medical_accueille">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_TEMPORELLES_ET_PRONOSTIC"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SERVICE_MEDICAL"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:label xml:lang="fr">service medical accueille</rdfs:label>
    <rdfs:comment xml:lang="fr">Lien entre un service de prise en charge et le patient qui y est hospitalise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#traitement_cible_defaillance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_THERAPEUTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#TRAITEMENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DEFAILLANCE_ORGANE"/>
    <rdfs:label xml:lang="fr">traitement cible defaillance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#Dossier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="fr">Dossier</rdfs:label>
    <rdfs:comment xml:lang="fr">Dossier médical scanné (identifiant pseudonymisé).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RELATIONS_BIOMARQUEURS_ET_MICROBIO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#relationClinique"/>
    <rdfs:label xml:lang="fr">relation des biomarqueurs et de la microbiologie</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#micro_organisme_isole_dans">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_BIOMARQUEURS_ET_MICROBIO"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#MICRO_ORGANISME"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#FOYER_INFECTIEUX"/>
    <rdfs:label xml:lang="fr">micro organisme isole dans</rdfs:label>
    <rdfs:comment xml:lang="fr">Site ou le pathogene a ete preleve ou isole (ex. hemoculture, LBA).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#antibiotique_inadequat_pour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_THERAPEUTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#TRAITEMENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#MICRO_ORGANISME"/>
    <rdfs:label xml:lang="fr">antibiotique inadequat pour</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="fr">Ontologie TRACE-Sepsis v2.0</rdfs:label>
    <owl:versionInfo>2.0</owl:versionInfo>
    <rdfs:comment xml:lang="fr">Ontologie générée à partir du TRACE-Sepsis Annotation Guideline : types d'entités, signatures des relations et règles dérivées.</rdfs:comment>
    <dcterms:source>Sepsis-2 (Levy et al., 2003, International Sepsis Definitions Conference)</dcterms:source>
    <dcterms:source>Sepsis-3 (Singer et al., 2016)</dcterms:source>
    <dcterms:source>Surviving Sepsis Campaign (SSC 2021)</dcterms:source>
    <dcterms:source>KDIGO AKI Guidelines 2012</dcterms:source>
    <dcterms:source>EUCAST v14.0 (2024)</dcterms:source>
    <dcterms:source>Vincent et al., 1996 (score SOFA)</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#SCORE_NEUROLOGIQUE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">score neurologique</rdfs:label>
    <skos:example>Glasgow</skos:example>
    <skos:example>RASS</skos:example>
    <skos:example>FOUR_score</skos:example>
    <skos:example>MMS</skos:example>
    <skos:example>testing_musculaire</skos:example>
    <rdfs:comment xml:lang="fr">Score neurologique explicitement rapporte dans le dossier clinique.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#section">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">section</rdfs:label>
    <rdfs:comment xml:lang="fr">Section du compte rendu où l'élément est cité.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#ira_a_pour_stade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#DEFAILLANCE_ORGANE"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#STADE_IRA"/>
    <rdfs:label xml:lang="fr">ira a pour stade</rdfs:label>
    <rdfs:comment xml:lang="fr">Relie une IRA (DEFAILLANCE_ORGANE, manifestation IRA) a son stade KDIGO 2012 (STADE_IRA). Creee uniquement si le stade est explicitement ecrit dans le document (regle R8_inference).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R11_site_infection_pathogene">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R11_site_infection_pathogene</rdfs:label>
    <rdfs:comment xml:lang="fr">Le site d'infection ne se deduit jamais de l'espece du pathogene : un pneumocoque (Streptococcus pneumoniae, synonymes : pneumocoque, S. pneumoniae) n'est pas uniquement pulmonaire (meninges, sang, oreille, sinus...). micro_organisme_infecte_site n'est cree que si le document nomme explicitement le site infecte.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#assertionSujet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#AssertionRelation"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">sujet de l'assertion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R9_SYMPTOME">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R9_SYMPTOME</rdfs:label>
    <rdfs:comment xml:lang="fr">Une relation presente_symptome est créée uniquement si le symptôme est explicitement mentionné dans le document. Aucune inférence diagnostique n'est autorisée à partir d'un symptôme seul.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R7_contexte_acquisition_risque_BMR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R7_contexte_acquisition_risque_BMR</rdfs:label>
    <rdfs:comment xml:lang="fr">CONTEXTE_ACQUISITION(type_acquisition=nosocomiale OU exposition_antibiotique_recente=true OU voyage recent a l'etranger dans un pays a forte prevalence de BMR) -&gt; contexte_acquisition_influence_risque_resistance(MICRO_ORGANISME, niveau=eleve_BMR).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R5_indication_corticoides">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R5_indication_corticoides</rdfs:label>
    <rdfs:comment xml:lang="fr">LABEL_NOSOLOGIQUE = choc_septique_refractaire -&gt; traitement_indique_par_label_nosologique(TRAITEMENT=corticoides)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#traitement_a_pour_posologie">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_THERAPEUTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#TRAITEMENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#POSOLOGIE"/>
    <rdfs:label xml:lang="fr">traitement a pour posologie</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#page">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="fr">page</rdfs:label>
    <rdfs:comment xml:lang="fr">Page du dossier où l'élément est écrit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#precede">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_TEMPORELLES_ET_PRONOSTIC"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#EVENEMENT_TEMPOREL"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#EVENEMENT_TEMPOREL"/>
    <rdfs:label xml:lang="fr">precede</rdfs:label>
    <rdfs:comment xml:lang="fr">Relation chronologique generique remplacant ordre_chronologique_prelevement_precede_ATB, delai_admission_vers_premier_ATB et delai_T0_vers_lactate_T2h. Chaque instance relie deux valeurs de EVENEMENT_TEMPOREL.valeurs_autorisees deja definies ; aucune paire specifique n'est plus figee dans le nom.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#antibiotique_adequat_pour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_THERAPEUTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#TRAITEMENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#MICRO_ORGANISME"/>
    <rdfs:label xml:lang="fr">antibiotique adequat pour</rdfs:label>
    <rdfs:comment xml:lang="fr">Conformite selon l'antibiogramme EUCAST.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#confianceModele">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">confiance du modèle</rdfs:label>
    <rdfs:comment xml:lang="fr">Confiance déclarée par le modèle à l'extraction.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b3">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#LABEL_NOSOLOGIQUE"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b4"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#DONNEE_PATIENT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">donnee patient</rdfs:label>
    <rdfs:comment xml:lang="fr">Donnees demographiques et administratives non identifiantes du patient (cardinalite : unique par dossier).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b16">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#COMORBIDITE_ANTECEDENT"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b17"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#a_pour_contexte_acquisition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_TERRAIN_ET_RISQUE"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#COMORBIDITE_ANTECEDENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#CONTEXTE_ACQUISITION"/>
    <rdfs:label xml:lang="fr">a pour contexte acquisition</rdfs:label>
    <rdfs:comment xml:lang="fr">Relation structurelle remplacant l'ancien attribut contexte_acquisition, desormais entite autonome.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#temporalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">temporalité</rdfs:label>
    <rdfs:comment xml:lang="fr">ANTERIEUR, SEJOUR ou SORTIE (étage 6 de TRACE).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#SERVICE_MEDICAL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">service medical</rdfs:label>
    <rdfs:comment xml:lang="fr">Unites ou services de prise en charge successifs au cours de l'hospitalisation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#stade_ira_calcule_pour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#STADE_IRA"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:label xml:lang="fr">stade ira calcule pour</rdfs:label>
    <rdfs:comment xml:lang="fr">Lien entre le stade d'insuffisance renale aigue (calcule selon KDIGO 2012) et le patient concerne.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R4_qsofa_critere_pression_arterielle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R4_qsofa_critere_pression_arterielle</rdfs:label>
    <rdfs:comment xml:lang="fr">SIGNE_VITAL(type=pression_arterielle_systolique, valeur &lt;= 100) -&gt; SCORE_qSOFA.critere_pression_arterielle_systolique = true</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#SCORE_qSOFA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">score qsofa</rdfs:label>
    <rdfs:comment xml:lang="fr">Outil de reperage rapide hors reanimation (score de 0 a 3).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#comorbidite_est_facteur_risque_de">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_TERRAIN_ET_RISQUE"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#COMORBIDITE_ANTECEDENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#LABEL_NOSOLOGIQUE"/>
    <rdfs:label xml:lang="fr">comorbidite est facteur risque de</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R8_IMAGERIE_PROCEDURE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R8_IMAGERIE_PROCEDURE</rdfs:label>
    <rdfs:comment xml:lang="fr">Une relation d'imagerie est creee uniquement si l'examen et l'entite cible sont presents dans le document. Aucune inference n'est autorisee.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#origine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">origine</rdfs:label>
    <rdfs:comment xml:lang="fr">extraction directe, réparation SGCE ou récupération structurée.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#horodatage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">horodatage</rdfs:label>
    <rdfs:comment xml:lang="fr">Date ou heure écrite avec l'entité.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#label_nosologique_a_pour_foyer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#LABEL_NOSOLOGIQUE"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#FOYER_INFECTIEUX"/>
    <rdfs:label xml:lang="fr">label nosologique a pour foyer</rdfs:label>
    <rdfs:comment xml:lang="fr">Relie un diagnostic (LABEL_NOSOLOGIQUE) a sa localisation (ex. 'choc septique' -&gt; 'point de depart pulmonaire', 'pyelonephrite' -&gt; 'droite'). Remplace presente_suspicion_infection : le foyer n'est plus relie directement au patient. Creee seulement si la localisation est ecrite.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#identifiantSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">identifiant source</rdfs:label>
    <rdfs:comment xml:lang="fr">Identifiant de l'élément dans le JSON TRACE.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RELATIONS_SYMPTOMES">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#relationClinique"/>
    <rdfs:label xml:lang="fr">relation des symptômes</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b17">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#EVENEMENT_TEMPOREL"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b18"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#DEFAILLANCE_ORGANE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">defaillance organe</rdfs:label>
    <rdfs:comment xml:lang="fr">Dysfonction d'un ou plusieurs systemes physiologiques.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#mention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">mention</rdfs:label>
    <rdfs:comment xml:lang="fr">Mention telle qu'elle est écrite dans la page.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#contexte_acquisition_influence_risque_resistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_TERRAIN_ET_RISQUE"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#CONTEXTE_ACQUISITION"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#MICRO_ORGANISME"/>
    <rdfs:label xml:lang="fr">contexte acquisition influence risque resistance</rdfs:label>
    <rdfs:comment xml:lang="fr">Relation generique remplacant contexte_acquisition_augmente_risque_BMR. Le niveau de risque specifique (ex. BMR) est porte par regles_derivees.R7, pas par le nom de la relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#presente_symptome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_SYMPTOMES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#SYMPTOME"/>
    <rdfs:label xml:lang="fr">presente symptome</rdfs:label>
    <rdfs:comment xml:lang="fr">Relie le patient aux symptômes explicitement mentionnés dans le dossier clinique.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#MICRO_ORGANISME">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">micro organisme</rdfs:label>
    <rdfs:comment xml:lang="fr">Agent pathogene identifie lors d'un prelevement microbiologique.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#biomarqueur_obtenu_a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_BIOMARQUEURS_ET_MICROBIO"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#BIOMARQUEUR"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#EVENEMENT_TEMPOREL"/>
    <rdfs:label xml:lang="fr">biomarqueur obtenu a</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b20">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#IMAGERIE_PROCEDURE"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b21"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#parametre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">paramètre</rdfs:label>
    <rdfs:comment xml:lang="fr">Forme canonique du concept (guideline).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#unite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">unité</rdfs:label>
    <rdfs:comment xml:lang="fr">Unité de la valeur.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RELATIONS_IMAGERIE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#relationClinique"/>
    <rdfs:label xml:lang="fr">relation d'imagerie</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#traitement_administre_a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_THERAPEUTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#TRAITEMENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:label xml:lang="fr">traitement administre a</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#score_sofa_inclut_score_neurologique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SCORE_SOFA"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#SCORE_NEUROLOGIQUE"/>
    <rdfs:label xml:lang="fr">score sofa inclut score neurologique</rdfs:label>
    <rdfs:comment xml:lang="fr">Le SOFA inclut le score neurologique, specifiquement sa composante neurologique (Glasgow). Validee par le medecin.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R3_qsofa_critere_frequence_respiratoire">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R3_qsofa_critere_frequence_respiratoire</rdfs:label>
    <rdfs:comment xml:lang="fr">SIGNE_VITAL(type=frequence_respiratoire, valeur &gt;= 22) -&gt; SCORE_qSOFA.critere_frequence_respiratoire = true</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b13">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#TRAITEMENT"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b14"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#aPourPatient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#Dossier"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#Patient"/>
    <rdfs:label xml:lang="fr">a pour patient</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#Patient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:label xml:lang="fr">Patient</rdfs:label>
    <rdfs:comment xml:lang="fr">Nœud unique du patient d'un dossier, qui réunit ses mentions ("le patient", "la patiente"...).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#score_qsofa_calcule_pour">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SCORE_qSOFA"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:label xml:lang="fr">score qsofa calcule pour</rdfs:label>
    <rdfs:comment xml:lang="fr">Lien entre le score qSOFA et le patient evalue.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RELATIONS_SIGNES_VITAUX">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#relationClinique"/>
    <rdfs:label xml:lang="fr">relation des signes vitaux</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b18">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#EVOLUTION_PRONOSTIC"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b19"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#CONTEXTE_ACQUISITION">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">contexte acquisition</rdfs:label>
    <rdfs:comment xml:lang="fr">Mode et circonstances d'acquisition d'une comorbidite ou d'une exposition, anciennement attribut isole de COMORBIDITE_ANTECEDENT, promu en entite car il porte sa propre relation vers MICRO_ORGANISME.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#presente_dysfonction_organe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DEFAILLANCE_ORGANE"/>
    <rdfs:label xml:lang="fr">presente dysfonction organe</rdfs:label>
    <rdfs:comment xml:lang="fr">Dysfonction d'organe induite par la reponse dysreguleee.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R4bis_qsofa_critere_neurologique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R4bis_qsofa_critere_neurologique</rdfs:label>
    <rdfs:comment xml:lang="fr">Existence d'une confusion ou d'un score de Glasgow &lt; 15 -&gt; SCORE_qSOFA.critere_alteration_etat_mental = true.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#patient_a_pour_evolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_TEMPORELLES_ET_PRONOSTIC"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#EVOLUTION_PRONOSTIC"/>
    <rdfs:label xml:lang="fr">patient a pour evolution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#biomarqueur_supporte_defaillance_organe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_BIOMARQUEURS_ET_MICROBIO"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#BIOMARQUEUR"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#DEFAILLANCE_ORGANE"/>
    <rdfs:label xml:lang="fr">biomarqueur supporte defaillance organe</rdfs:label>
    <rdfs:comment xml:lang="fr">Voir BIOMARQUEUR.orientation_clinique pour les biomarqueurs propres a chaque defaillance.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#biomarqueur_est_critere_de">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_BIOMARQUEURS_ET_MICROBIO"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#BIOMARQUEUR"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#LABEL_NOSOLOGIQUE"/>
    <rdfs:label xml:lang="fr">biomarqueur est critere de</rdfs:label>
    <rdfs:comment xml:lang="fr">Relation generique remplacant biomarqueur_est_composante_choc_septique. Le seuil (ex. lactate &gt;= 2 mmol/L) est porte par regles_derivees.R1, pas par le nom de la relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b8">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#SCORE_NEUROLOGIQUE"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b9"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#relationClinique"/>
    <rdfs:label xml:lang="fr">relation diagnostique</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b2">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#DONNEE_PATIENT"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R2_delai_ATB_mortalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R2_delai_ATB_mortalite</rdfs:label>
    <rdfs:comment xml:lang="fr">EVENEMENT_TEMPOREL(type=premiere_dose_antibiotique, delai_depuis_admission_minutes &gt; 60) -&gt; evenement_associe_evolution(EVOLUTION_PRONOSTIC, risque=eleve)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R10_stade_IRA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R10_stade_IRA</rdfs:label>
    <rdfs:comment xml:lang="fr">DEFAILLANCE_ORGANE(IRA) -&gt; ira_a_pour_stade(STADE_IRA) uniquement si le stade est explicitement ecrit dans le document (pas de calcul a partir de la creatinine).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#typeRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="fr">type de relation</rdfs:label>
    <rdfs:comment xml:lang="fr">Propriété (relation du guideline) portée par une assertion.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#regle_R1_lactate_critere_choc_septique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://example.org/trace-sepsis/onto#RegleDerivee"/>
    <rdfs:label>R1_lactate_critere_choc_septique</rdfs:label>
    <rdfs:comment xml:lang="fr">Definition Sepsis-3 du choc septique : presence de vasopresseurs ET BIOMARQUEUR(type=lactate, valeur &gt;= 2, unite=mmol/L) -&gt; biomarqueur_est_critere_de(LABEL_NOSOLOGIQUE=choc_septique).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RELATIONS_THERAPEUTIQUES">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#relationClinique"/>
    <rdfs:label xml:lang="fr">relation thérapeutique</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#assertionObjet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#AssertionRelation"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">objet de l'assertion</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b5">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#BIOMARQUEUR"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b6"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#imagerie_objective_foyer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_IMAGERIE"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#IMAGERIE_PROCEDURE"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#FOYER_INFECTIEUX"/>
    <rdfs:label xml:lang="fr">imagerie objective foyer</rdfs:label>
    <rdfs:comment xml:lang="fr">L'examen d'imagerie objective un foyer infectieux.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#niveauConfiance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">niveau de confiance TRACE</rdfs:label>
    <rdfs:comment xml:lang="fr">HIGH, MEDIUM ou LOW (arbitrage de TRACE).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#traitement_indique_par_label_nosologique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_THERAPEUTIQUES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#TRAITEMENT"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#LABEL_NOSOLOGIQUE"/>
    <rdfs:label xml:lang="fr">traitement indique par label nosologique</rdfs:label>
    <rdfs:comment xml:lang="fr">Relation generique remplacant corticoide_indique_par_choc_refractaire. La condition specifique (corticoides &lt;-&gt; choc_septique_refractaire) est portee par regles_derivees.R5, pas par le nom de la relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#valeur">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">valeur</rdfs:label>
    <rdfs:comment xml:lang="fr">Valeur écrite (texte).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b9">
    <rdf:first rdf:resource="http://example.org/trace-sepsis/onto#STADE_IRA"/>
    <rdf:rest rdf:nodeID="n6c0cd5e68f4847f1b1696092da096125b10"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#relationClinique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">relation clinique</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#FOYER_INFECTIEUX">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">foyer infectieux</rdfs:label>
    <rdfs:comment xml:lang="fr">Localisation anatomique de l'infection (organe, region, site), suspectee ou confirmee. C'est UNIQUEMENT une localisation, toujours celle d'un diagnostic : le nom d'un diagnostic infectieux (pneumopathie, PAVM...) n'est jamais un FOYER_INFECTIEUX mais un LABEL_NOSOLOGIQUE. FOYER_INFECTIEUX est RESERVE a la localisation d'un LABEL_NOSOLOGIQUE, auquel il est relie par label_nosologique_a_pour_foyer ; la localisation d'une COMORBIDITE_ANTECEDENT n'est pas un FOYER_INFECTIEUX.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#preuve">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="fr">preuve</rdfs:label>
    <rdfs:comment xml:lang="fr">Passage du dossier qui justifie l'élément.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RegleDerivee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="fr">Règle dérivée</rdfs:label>
    <rdfs:comment xml:lang="fr">Règle clinique dérivée du guideline, à formaliser en SWRL ou SHACL-SPARQL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#EntiteClinique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="fr">Entité clinique</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#example">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#score_sofa_inclut_biomarqueur">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_DIAGNOSTIQUES"/>
