  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#symptome_associe_gravite_initiale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_SYMPTOMES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SYMPTOME"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#SCORE_SOFA"/>
    <rdfs:label xml:lang="fr">symptome associe gravite initiale</rdfs:label>
    <rdfs:comment xml:lang="fr">Le symptome participe a la gravite initiale du patient, evaluee par le score SOFA (ex. confusion -&gt; composante neurologique). Creee seulement si le document l'etablit.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#SIGNE_VITAL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/trace-sepsis/onto#EntiteClinique"/>
    <rdfs:label xml:lang="fr">signe vital</rdfs:label>
    <skos:example>frequence_cardiaque</skos:example>
    <skos:example>pression_arterielle_systolique</skos:example>
    <skos:example>pression_arterielle_diastolique</skos:example>
    <skos:example>pression_arterielle_moyenne</skos:example>
    <skos:example>frequence_respiratoire</skos:example>
    <skos:example>temperature_corporelle</skos:example>
    <skos:example>SpO2</skos:example>
    <skos:example>debit_cardiaque</skos:example>
    <skos:example>index_cardiaque</skos:example>
    <skos:example>pression_veineuse_centrale</skos:example>
    <skos:example>saturation_veineuse_centrale_O2</skos:example>
    <skos:example>diurese_horaire</skos:example>
    <skos:example>diurese_24h</skos:example>
    <skos:example>temps_recoloration_cutanee</skos:example>
    <skos:example>FiO2</skos:example>
    <skos:example>PEEP</skos:example>
    <skos:example>pression_plateau</skos:example>
    <skos:example>poids</skos:example>
    <skos:example>IMC</skos:example>
    <rdfs:comment xml:lang="fr">Parametres physiologiques, hemodynamiques et ventilatoires mesures ponctuellement chez le patient.</rdfs:comment>
  </rdf:Description>
