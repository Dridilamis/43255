  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#symptome_oriente_foyer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://example.org/trace-sepsis/onto#RELATIONS_SYMPTOMES"/>
    <rdfs:domain rdf:resource="http://example.org/trace-sepsis/onto#SYMPTOME"/>
    <rdfs:range rdf:resource="http://example.org/trace-sepsis/onto#FOYER_INFECTIEUX"/>
    <rdfs:label xml:lang="fr">symptome oriente foyer</rdfs:label>
    <rdfs:comment xml:lang="fr">Le symptome oriente vers un foyer infectieux (ex. toux, expectoration -&gt; pulmonaire ; brulures mictionnelles -&gt; voies urinaires). Creee seulement si le document relie explicitement le symptome au foyer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#valeurNumerique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="fr">valeur numérique</rdfs:label>
    <rdfs:comment xml:lang="fr">Valeur convertie en nombre lorsque c'est possible.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/trace-sepsis/onto#RELATIONS_TERRAIN_ET_RISQUE">
