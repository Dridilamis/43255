    <skos:example>cephalees</skos:example>
    <skos:example>toux</skos:example>
    <skos:example>dyspnee</skos:example>
    <skos:example>orthopnee</skos:example>
    <skos:example>polypnee</skos:example>
    <skos:example>expectoration</skos:example>
    <skos:example>douleur_thoracique</skos:example>
    <skos:example>douleur_abdominale</skos:example>
    <skos:example>douleur_lombaire</skos:example>
    <skos:example>myalgies</skos:example>
    <skos:example>nausees</skos:example>
    <skos:example>vomissements</skos:example>
    <skos:example>diarrhee</skos:example>
    <skos:example>fatigue</skos:example>
    <skos:example>asthenie</skos:example>
    <skos:example>anorexie</skos:example>
    <skos:example>confusion</skos:example>
    <skos:example>agitation</skos:example>
    <skos:example>somnolence</skos:example>
    <skos:example>desorientation</skos:example>
    <skos:example>ralentissement_psychomoteur</skos:example>
    <skos:example>trouble_deglutition</skos:example>
    <skos:example>fausse_route</skos:example>
    <skos:example>cyanose</skos:example>
    <skos:example>marbrures</skos:example>
    <skos:example>extremites_froides</skos:example>
    <skos:example>tirage</skos:example>
    <skos:example>crepitants</skos:example>
    <skos:example>ronchis</skos:example>
    <skos:example>sibilants</skos:example>
    <skos:example>encombrement</skos:example>
    <skos:example>malaise</skos:example>
    <skos:example>syncope</skos:example>
    <skos:example>photophobie</skos:example>
    <skos:example>raideur_nuque</skos:example>
    <skos:example>urines_foncees</skos:example>
    <skos:example>hematurie</skos:example>
    <skos:example>oligurie</skos:example>
    <skos:example>anurie</skos:example>
    <skos:example>ictere</skos:example>
    <skos:example>purpura</skos:example>
    <skos:example>alteration_etat_general</skos:example>
    <skos:example>perte_poids</skos:example>
    <rdfs:comment xml:lang="fr">Manifestation clinique rapportée par le patient ou observée lors de l'examen clinique. Un symptôme ne constitue pas un diagnostic, une défaillance d'organe ni un résultat biologique.</rdfs:comment>
  </rdf:Description>
