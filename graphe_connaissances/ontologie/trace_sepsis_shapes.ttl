:Forme_a_pour_label_nosologique a sh:NodeShape ;
    sh:targetSubjectsOf :a_pour_label_nosologique ;
    sh:class :DONNEE_PATIENT ;
    sh:message "Le sujet de a_pour_label_nosologique doit etre un DONNEE_PATIENT" ;
    sh:property [ sh:path :a_pour_label_nosologique ; sh:class :LABEL_NOSOLOGIQUE ;
                  sh:message "L objet de a_pour_label_nosologique doit etre un LABEL_NOSOLOGIQUE" ] .

