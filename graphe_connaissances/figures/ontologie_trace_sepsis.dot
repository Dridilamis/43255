digraph ontologie {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, pad=0.3,
         fontname="Helvetica", fontsize=20, labelloc=t, label="", bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, penwidth=1.6,
        margin="0.18,0.08"];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1.2];
    DONNEE_PATIENT [label="Patient", fillcolor="#dbe8fb", color="#2a6fdb", fontsize=17, penwidth=2.6, margin="0.3,0.15"];
    SERVICE_MEDICAL [label="Service médical", fillcolor="#dbe8fb", color="#2a6fdb"];
    EVENEMENT_TEMPOREL [label="Événement temporel", fillcolor="#dbe8fb", color="#2a6fdb"];
    EVOLUTION_PRONOSTIC [label="Évolution / pronostic", fillcolor="#dbe8fb", color="#2a6fdb"];
    LABEL_NOSOLOGIQUE [label="Diagnostic", fillcolor="#fbe0dd", color="#c0392b"];
    FOYER_INFECTIEUX [label="Foyer infectieux", fillcolor="#fbe0dd", color="#c0392b"];
    DEFAILLANCE_ORGANE [label="Défaillance d'organe", fillcolor="#fbe0dd", color="#c0392b"];
    STADE_IRA [label="Stade d'IRA", fillcolor="#fbe0dd", color="#c0392b"];
    SCORE_SOFA [label="Score SOFA", fillcolor="#fbe0dd", color="#c0392b"];
    SCORE_qSOFA [label="Score qSOFA", fillcolor="#fbe0dd", color="#c0392b"];
    SCORE_NEUROLOGIQUE [label="Score neurologique", fillcolor="#fbe0dd", color="#c0392b"];
    TRAITEMENT [label="Traitement", fillcolor="#d9f2ea", color="#16a085"];
    POSOLOGIE [label="Posologie", fillcolor="#d9f2ea", color="#16a085"];
    BIOMARQUEUR [label="Biomarqueur", fillcolor="#efe6f8", color="#7d3c98"];
    MICRO_ORGANISME [label="Micro-organisme", fillcolor="#efe6f8", color="#7d3c98"];
    SIGNE_VITAL [label="Signe vital", fillcolor="#efe6f8", color="#7d3c98"];
    SYMPTOME [label="Symptôme", fillcolor="#fdf3d6", color="#b7950b"];
    IMAGERIE_PROCEDURE [label="Imagerie / procédure", fillcolor="#fdf3d6", color="#b7950b"];
    COMORBIDITE_ANTECEDENT [label="Comorbidité / antécédent", fillcolor="#ececec", color="#7f8c8d"];
    CONTEXTE_ACQUISITION [label="Contexte d'acquisition", fillcolor="#ececec", color="#7f8c8d"];
  legende [shape=plaintext, style="", fontsize=11, label=<<TABLE BORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#dbe8fb" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#2a6fdb">Patient et parcours</FONT></TD></TR><TR><TD BGCOLOR="#fbe0dd" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#c0392b">Diagnostic et gravité</FONT></TD></TR><TR><TD BGCOLOR="#d9f2ea" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#16a085">Thérapeutique</FONT></TD></TR><TR><TD BGCOLOR="#efe6f8" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#7d3c98">Biologie et microbiologie</FONT></TD></TR><TR><TD BGCOLOR="#fdf3d6" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#b7950b">Clinique et imagerie</FONT></TD></TR><TR><TD BGCOLOR="#ececec" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#7f8c8d">Terrain</FONT></TD></TR></TABLE>>];
  DONNEE_PATIENT -> LABEL_NOSOLOGIQUE [label="a pour\nlabel nosologique", color="#c0392b", fontcolor="#c0392b"];
  LABEL_NOSOLOGIQUE -> FOYER_INFECTIEUX [label="label nosologique\na pour foyer", color="#c0392b", fontcolor="#c0392b"];
  DONNEE_PATIENT -> DEFAILLANCE_ORGANE [label="presente\ndysfonction organe", color="#c0392b", fontcolor="#c0392b"];
  DONNEE_PATIENT -> SCORE_SOFA [label="score sofa\ncalcule pour", color="#c0392b", fontcolor="#c0392b", dir=back];
  SCORE_SOFA -> BIOMARQUEUR [label="score sofa\ninclut biomarqueur", color="#c0392b", fontcolor="#c0392b"];
  SCORE_SOFA -> SIGNE_VITAL [label="score sofa\ninclut signe vital", color="#c0392b", fontcolor="#c0392b"];
  SCORE_SOFA -> SCORE_NEUROLOGIQUE [label="score sofa\ninclut score neurologique", color="#c0392b", fontcolor="#c0392b"];
  DONNEE_PATIENT -> SCORE_qSOFA [label="score qsofa\ncalcule pour", color="#c0392b", fontcolor="#c0392b", dir=back];
  SCORE_qSOFA -> SCORE_NEUROLOGIQUE [label="score qsofa\ninclut score neurologique", color="#c0392b", fontcolor="#c0392b"];
  DONNEE_PATIENT -> STADE_IRA [label="stade ira calcule pour", color="#c0392b", fontcolor="#c0392b", dir=back];
  DEFAILLANCE_ORGANE -> STADE_IRA [label="ira a pour stade", color="#c0392b", fontcolor="#c0392b"];
  DONNEE_PATIENT -> TRAITEMENT [label="traitement\nadministre a", color="#16a085", fontcolor="#16a085", dir=back];
  TRAITEMENT -> POSOLOGIE [label="traitement a\npour posologie", color="#16a085", fontcolor="#16a085"];
  TRAITEMENT -> MICRO_ORGANISME [label="antibiotique\nadequat pour", color="#16a085", fontcolor="#16a085"];
  TRAITEMENT -> MICRO_ORGANISME [label="antibiotique\ninadequat pour", color="#16a085", fontcolor="#16a085"];
  TRAITEMENT -> DEFAILLANCE_ORGANE [label="traitement\ncible defaillance", color="#16a085", fontcolor="#16a085"];
  TRAITEMENT -> LABEL_NOSOLOGIQUE [label="traitement indique\npar label nosologique", color="#16a085", fontcolor="#16a085"];
  SIGNE_VITAL -> DEFAILLANCE_ORGANE [label="signe vital\nsupporte defaillance organe", color="#5dade2", fontcolor="#5dade2"];
  BIOMARQUEUR -> EVENEMENT_TEMPOREL [label="biomarqueur obtenu a", color="#7d3c98", fontcolor="#7d3c98"];
  BIOMARQUEUR -> DEFAILLANCE_ORGANE [label="biomarqueur supporte\ndefaillance organe", color="#7d3c98", fontcolor="#7d3c98"];
  BIOMARQUEUR -> LABEL_NOSOLOGIQUE [label="biomarqueur est\ncritere de", color="#7d3c98", fontcolor="#7d3c98"];
  MICRO_ORGANISME -> FOYER_INFECTIEUX [label="micro organisme\nisole dans", color="#7d3c98", fontcolor="#7d3c98"];
  COMORBIDITE_ANTECEDENT -> LABEL_NOSOLOGIQUE [label="comorbidite est\nfacteur risque de", color="#7f8c8d", fontcolor="#7f8c8d"];
  COMORBIDITE_ANTECEDENT -> CONTEXTE_ACQUISITION [label="a pour\ncontexte acquisition", color="#7f8c8d", fontcolor="#7f8c8d"];
  CONTEXTE_ACQUISITION -> MICRO_ORGANISME [label="contexte acquisition\ninfluence risque resistance", color="#7f8c8d", fontcolor="#7f8c8d"];
  EVENEMENT_TEMPOREL -> EVENEMENT_TEMPOREL [label="precede", color="#34495e", fontcolor="#34495e"];
  DONNEE_PATIENT -> EVOLUTION_PRONOSTIC [label="patient a\npour evolution", color="#34495e", fontcolor="#34495e"];
  EVENEMENT_TEMPOREL -> EVOLUTION_PRONOSTIC [label="evenement\nassocie evolution", color="#34495e", fontcolor="#34495e"];
  DONNEE_PATIENT -> SERVICE_MEDICAL [label="service\nmedical accueille", color="#34495e", fontcolor="#34495e", dir=back];
  IMAGERIE_PROCEDURE -> FOYER_INFECTIEUX [label="imagerie\nobjective foyer", color="#b7950b", fontcolor="#b7950b"];
  DONNEE_PATIENT -> SYMPTOME [label="presente symptome", color="#b7950b", fontcolor="#b7950b"];
  MICRO_ORGANISME -> FOYER_INFECTIEUX [label="micro organisme\ninfecte site", color="#7d3c98", fontcolor="#7d3c98"];
  SYMPTOME -> FOYER_INFECTIEUX [label="symptome oriente foyer", color="#b7950b", fontcolor="#b7950b"];
  SYMPTOME -> SCORE_SOFA [label="symptome associe\ngravite initiale", color="#b7950b", fontcolor="#b7950b"];
}