digraph ontologie {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, pad=0.3,
         fontname="Helvetica", fontsize=20, labelloc=t, label="", bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, penwidth=1.6,
        margin="0.18,0.08"];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.7, penwidth=1.2];
    DONNEE_PATIENT [label="Patient", fillcolor="#dbe8fb", color="#2a6fdb", fontsize=17, penwidth=2.6, margin="0.3,0.15"];
    SERVICE_MEDICAL [label="Service médical", fillcolor="#dbe8fb", color="#2a6fdb"];
    EVENEMENT_TEMPOREL [label="Événement temporel", fillcolor="#dbe8fb", color="#2a6fdb"];
    EVOLUTION_PRONOSTIC [label="Évolution / pronostic", fillcolor="#dbe8fb", color="#2a6fdb"];
    LABEL_NOSOLOGIQUE [label="Diagnostic", fillcolor="#fbe0dd", color="#c0392b"];
    FOYER_INFECTIEUX [label="Foyer infectieux", fillcolor="#fbe0dd", color="#c0392b"];
    DEFAILLANCE_ORGANE [label="Défaillance d'organe", fillcolor="#fbe0dd", color="#c0392b"];
    STADE_IRA [label="Stade d'IRA", fillcolor="#fbe0dd", color="#c0392b"];
    SCORE_SOFA [label="Score SOFA", fillcolor="#fbe0dd", color="#c0392b"];
    SCORE_qSOFA [label="Score qSOFA", fillcolor="#fbe0dd", color="#c0392b"];
    SCORE_NEUROLOGIQUE [label="Score neurologique", fillcolor="#fbe0dd", color="#c0392b"];
    TRAITEMENT [label="Traitement", fillcolor="#d9f2ea", color="#16a085"];
    POSOLOGIE [label="Posologie", fillcolor="#d9f2ea", color="#16a085"];
    BIOMARQUEUR [label="Biomarqueur", fillcolor="#efe6f8", color="#7d3c98"];
    MICRO_ORGANISME [label="Micro-organisme", fillcolor="#efe6f8", color="#7d3c98"];
    SIGNE_VITAL [label="Signe vital", fillcolor="#efe6f8", color="#7d3c98"];
    SYMPTOME [label="Symptôme", fillcolor="#fdf3d6", color="#b7950b"];
    IMAGERIE_PROCEDURE [label="Imagerie / procédure", fillcolor="#fdf3d6", color="#b7950b"];
    COMORBIDITE_ANTECEDENT [label="Comorbidité / antécédent", fillcolor="#ececec", color="#7f8c8d"];
    CONTEXTE_ACQUISITION [label="Contexte d'acquisition", fillcolor="#ececec", color="#7f8c8d"];
  legende [shape=plaintext, style="", fontsize=11, label=<<TABLE BORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#dbe8fb" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#2a6fdb">Patient et parcours</FONT></TD></TR><TR><TD BGCOLOR="#fbe0dd" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#c0392b">Diagnostic et gravité</FONT></TD></TR><TR><TD BGCOLOR="#d9f2ea" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#16a085">Thérapeutique</FONT></TD></TR><TR><TD BGCOLOR="#efe6f8" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#7d3c98">Biologie et microbiologie</FONT></TD></TR><TR><TD BGCOLOR="#fdf3d6" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#b7950b">Clinique et imagerie</FONT></TD></TR><TR><TD BGCOLOR="#ececec" WIDTH="18"></TD><TD ALIGN="LEFT"><FONT COLOR="#7f8c8d">Terrain</FONT></TD></TR></TABLE>>];
  DONNEE_PATIENT -> LABEL_NOSOLOGIQUE [label="a pour\nlabel nosologique\n(349)", color="#c0392b", fontcolor="#c0392b", penwidth=2.4];
  LABEL_NOSOLOGIQUE -> FOYER_INFECTIEUX [label="label nosologique\na pour foyer", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  DONNEE_PATIENT -> DEFAILLANCE_ORGANE [label="presente\ndysfonction organe\n(300)", color="#c0392b", fontcolor="#c0392b", penwidth=2.2];
  DONNEE_PATIENT -> SCORE_SOFA [label="score sofa\ncalcule pour\n(5)", color="#c0392b", fontcolor="#c0392b", penwidth=1.2, dir=back];
  SCORE_SOFA -> BIOMARQUEUR [label="score sofa\ninclut biomarqueur", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  SCORE_SOFA -> SIGNE_VITAL [label="score sofa\ninclut signe vital", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  SCORE_SOFA -> SCORE_NEUROLOGIQUE [label="score sofa\ninclut score neurologique", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  DONNEE_PATIENT -> SCORE_qSOFA [label="score qsofa\ncalcule pour", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed, dir=back];
  SCORE_qSOFA -> SCORE_NEUROLOGIQUE [label="score qsofa\ninclut score neurologique", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  DONNEE_PATIENT -> STADE_IRA [label="stade ira calcule pour", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed, dir=back];
  DEFAILLANCE_ORGANE -> STADE_IRA [label="ira a pour stade", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  DONNEE_PATIENT -> TRAITEMENT [label="traitement\nadministre a\n(1476)", color="#16a085", fontcolor="#16a085", penwidth=5.2, dir=back];
  TRAITEMENT -> POSOLOGIE [label="traitement a\npour posologie\n(840)", color="#16a085", fontcolor="#16a085", penwidth=4.0];
  TRAITEMENT -> MICRO_ORGANISME [label="antibiotique\nadequat pour", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  TRAITEMENT -> MICRO_ORGANISME [label="antibiotique\ninadequat pour", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  TRAITEMENT -> DEFAILLANCE_ORGANE [label="traitement\ncible defaillance", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  TRAITEMENT -> LABEL_NOSOLOGIQUE [label="traitement indique\npar label nosologique", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  SIGNE_VITAL -> DEFAILLANCE_ORGANE [label="signe vital\nsupporte defaillance organe", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  BIOMARQUEUR -> EVENEMENT_TEMPOREL [label="biomarqueur obtenu a", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  BIOMARQUEUR -> DEFAILLANCE_ORGANE [label="biomarqueur supporte\ndefaillance organe", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  BIOMARQUEUR -> LABEL_NOSOLOGIQUE [label="biomarqueur est\ncritere de", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  MICRO_ORGANISME -> FOYER_INFECTIEUX [label="micro organisme\nisole dans", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  COMORBIDITE_ANTECEDENT -> LABEL_NOSOLOGIQUE [label="comorbidite est\nfacteur risque de", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  COMORBIDITE_ANTECEDENT -> CONTEXTE_ACQUISITION [label="a pour\ncontexte acquisition\n(1)", color="#7f8c8d", fontcolor="#7f8c8d", penwidth=1.2];
  CONTEXTE_ACQUISITION -> MICRO_ORGANISME [label="contexte acquisition\ninfluence risque resistance", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  EVENEMENT_TEMPOREL -> EVENEMENT_TEMPOREL [label="precede", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  DONNEE_PATIENT -> EVOLUTION_PRONOSTIC [label="patient a\npour evolution\n(83)", color="#34495e", fontcolor="#34495e", penwidth=1.5];
  EVENEMENT_TEMPOREL -> EVOLUTION_PRONOSTIC [label="evenement\nassocie evolution", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  DONNEE_PATIENT -> SERVICE_MEDICAL [label="service\nmedical accueille\n(80)", color="#34495e", fontcolor="#34495e", penwidth=1.5, dir=back];
  IMAGERIE_PROCEDURE -> FOYER_INFECTIEUX [label="imagerie\nobjective foyer", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  DONNEE_PATIENT -> SYMPTOME [label="presente symptome\n(1029)", color="#b7950b", fontcolor="#b7950b", penwidth=4.6];
  MICRO_ORGANISME -> FOYER_INFECTIEUX [label="micro organisme\ninfecte site", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  SYMPTOME -> FOYER_INFECTIEUX [label="symptome oriente foyer", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
  SYMPTOME -> SCORE_SOFA [label="symptome associe\ngravite initiale", color="#c8c8c8", fontcolor="#a8a8a8", style=dashed];
}